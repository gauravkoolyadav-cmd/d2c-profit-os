# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host/db?sslmode=require
AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── V1 Profit Dashboard ─────────────────────────────────────────────
# Shopify webhook signing secret (app-wide). A per-store secret can also be saved
# when connecting a store (custom apps each have their own).
SHOPIFY_WEBHOOK_SECRET=
# Shopify Admin REST API version used by the catch-up sync
SHOPIFY_API_VERSION=2025-07

# Meta Marketing API version used by the spend sync
META_API_VERSION=v23.0

# Google Sheets (service account, read-only). Share each brand's sheet with this email as Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key; "\n" escapes are accepted
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Protects /api/cron/profit-sync (GitHub Actions sends "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# ── Other (unchanged, optional) ─────────────────────────────────────
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ENCRYPTION_KEY=
POLAR_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET=
